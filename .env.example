# SYNEX Hackathon Portal Configuration
# Copy this file to .env and adjust values for your environment

# Flask Application Settings
SECRET_KEY=synex-super-secret-key-change-in-production-2026
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=synex_hackathon
DB_USER=synex_app
DB_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Set to true to allow fallback to SQLite if MySQL is unavailable during local development
# Set to false to enforce strict MySQL usage (fails with an error if MySQL cannot connect)
USE_SQLITE_FALLBACK=false

# Razorpay Payment Gateway (Test Mode Credentials)
# Get your free test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_SYNEX_DEMO_KEY
RAZORPAY_KEY_SECRET=synex_razorpay_secret_test_2026
RAZORPAY_WEBHOOK_SECRET=synex_webhook_secret_test_2026

# Hackathon Fee Settings (in INR)
EVENT_NAME=SYNEX 2026
EVENT_INDIVIDUAL_FEE=299
EVENT_TEAM_FEE=999
EVENT_CURRENCY=INR

# Outgoing Email Delivery Settings
# Option 1 (Recommended): Resend HTTPS API (Operates over port 443; bypasses ISP port blocks on 587/465)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_free_api_key_here

# Option 2: Standard SMTP Server (Use if SMTP ports 587/465 are unblocked on your network)
# EMAIL_PROVIDER=smtp
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=SYNEX Hackathon Team <noreply@synex.org>

# Admin Session Configuration
ADMIN_SESSION_LIFETIME_HOURS=12
